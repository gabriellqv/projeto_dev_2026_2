# Copie este arquivo para `.env` antes de subir a stack com Docker Compose:
#   cp .env.example .env
#
# As variáveis JWT_SECRET e ADMIN_PASSWORD são obrigatórias (o compose falha
# se estiverem ausentes). Ajuste os valores antes de rodar `docker compose up`.

# Segredo usado para assinar os tokens JWT (mínimo 32 caracteres).
JWT_SECRET=chave-secreta-de-exemplo-com-mais-de-32-caracteres

# Senha do usuário administrador criado pelo seed (mínimo 8 caracteres).
ADMIN_PASSWORD=admin123

# Credenciais do banco PostgreSQL (usadas pelo serviço `postgres`).
POSTGRES_USER=odontoagenda
POSTGRES_PASSWORD=odontoagenda
POSTGRES_DB=odontoagenda
